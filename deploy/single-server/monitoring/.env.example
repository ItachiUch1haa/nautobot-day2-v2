# Copy this to monitoring/.env and fill in real values yourself on the
# remote server — do NOT paste the filled-in version back into chat.
#
# Get the real values from your existing stack's own .env / docker-compose.yml,
# e.g.: grep -i POSTGRES ~/nautobot-day2-v2/deploy/single-server/.env
#
# Best practice if you have a minute: create a dedicated read-only Postgres
# role for the exporter instead of reusing Nautobot's own app credential —
# something like:
#   docker compose exec -T postgres psql -U <admin_user> -d nautobot -c \
#     "CREATE ROLE monitoring WITH LOGIN PASSWORD 'pick-something'; \
#      GRANT pg_monitor TO monitoring;"
# then use that role below instead of the app's own user.

DATA_SOURCE_NAME=postgresql://<user>:<password>@postgres:5432/<dbname>?sslmode=disable

# If Redis has no password (common default), leave REDIS_PASSWORD unset —
# redis_exporter tolerates its absence.
REDIS_ADDR=redis://redis:6379
# REDIS_PASSWORD=<password if AUTH is enabled>
