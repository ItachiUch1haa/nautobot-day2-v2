# Copy to .env and change every value below before bringing this up anywhere
# reachable — these defaults are test-only and are not secret.

NAUTOBOT_SECRET_KEY=change-me-to-a-random-50-char-string
NAUTOBOT_DB_PASSWORD=change-me
NAUTOBOT_REDIS_PASSWORD=change-me

NAUTOBOT_SUPERUSER_NAME=admin
NAUTOBOT_SUPERUSER_EMAIL=admin@example.com
NAUTOBOT_SUPERUSER_PASSWORD=change-me
NAUTOBOT_SUPERUSER_API_TOKEN=change-me-generate-a-random-40-char-hex-token

# OpenBao AppRole Secret IDs — leave blank until INSTALL.md Phase 8 (OpenBao
# doesn't exist yet on a fresh install, so there's nothing real to put here
# until then). Phase 8 generates these three values and comes back to this
# file. The matching Role IDs are already hardcoded in docker-compose.yml —
# Phase 8 creates AppRoles with those exact Role IDs, so only the Secret
# IDs below need to be filled in; nothing in docker-compose.yml needs editing.
BAO_SECRET_ID=
BAO_BROKER_SECRET_ID=
BAO_REFRESHER_SECRET_ID=
